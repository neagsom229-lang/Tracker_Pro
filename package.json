{
  "name": "obsidian-finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node scripts/check-vercel-env.mjs && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude \"**/*.int.test.*\"",
    "test:integration": "vitest run --no-file-parallelism .int.test.",
    "lint": "eslint .",
    "ui:check": "node scripts/ui-check.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "keyboard:check": "node scripts/keyboard-check.mjs",
    "check:imports": "node scripts/check-import-case.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "verify": "npm run check:imports && npm run assets:check && npm run lint && npm run test:unit && npm run db:reset:test && npm run test:integration && npm run build && npm run smoke:local",
    "coverage": "vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=.env server/db-migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/db-seed.js",
    "db:reset": "node scripts/db-reset.mjs",
    "db:reset:test": "node scripts/db-reset.mjs --test",
    "db:check": "node --env-file-if-exists=.env server/db-check.js",
    "db:schema": "node --env-file-if-exists=.env server/db-schema.js",
    "api:start": "node --env-file-if-exists=.env server/index.js",
    "api:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.0.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^11.3.24",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.427.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.12.7",
    "zod": "^4.6.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.2",
    "playwright": "^1.65.1",
    "postcss": "^8.4.40",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.7",
    "vite": "^7.3.6",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
