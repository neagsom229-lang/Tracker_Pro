# Copy this file to .env for local development, and set the same keys
# in your Vercel project settings for production.

# ---- Local PostgreSQL (tracker_db) — placeholders; fill in .env once you have a password ----
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=tracker_db
# PGUSER=postgres
# PGPASSWORD=

# Node environment — the seed refuses to run unless this is development (or unset).
NODE_ENV=development

# Tests run against the separate tracker_db_test — never the dev DB.
# scripts/test-db.mjs refuses to reset anything whose name doesn't end with "_test".
TEST_PGDATABASE=tracker_db_test

# JWT secret for the Express auth backend (httpOnly session cookie).
# Server-side only — never commit the real value.
# JWT_SECRET=your-256-bit-random-secret

# Origin allowed by the API's CORS (Vite dev origin).
# APP_ORIGIN=http://localhost:5173

# Local backend switch: 'local' = Express + tracker_db (Vite proxies /api -> :4000);
# 'supabase' (or unset) = existing Supabase flow. Default is 'supabase'.
# VITE_DATA_BACKEND=local
# VITE_API_BASE=/api

# The API mounts PUT /api/profile/is_pro (the local-mode Pro dev toggle) only
# when NODE_ENV=development (true in .env) AND this flag is true. The
# BillingPanel shows the toggle only in dev builds (import.meta.env.DEV).
# NODE_ENV=development
# ENABLE_DEV_PRO_TOGGLE=true

# ---- Supabase (Project Settings > API) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe Payment Link (public). Test mode for private beta; switch to live
# only after a full test-mode payment works end-to-end.
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxx

# ---------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. They are consumed by the
# Supabase Edge Functions in supabase/functions/, NOT by the Vite app —
# never prefix these with VITE_ or they would be bundled into the
# browser JS and leak publicly. Set them with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_xxx ...
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# SUPABASE_URL=https://your-project.supabase.co               (auto-set by Supabase)
# SUPABASE_ANON_KEY=...                                        (auto-set by Supabase)
# SUPABASE_SERVICE_ROLE_KEY=...                                 (Project Settings > API)
