# Copy this file to .env for local development, and set the same keys
# in your Vercel project settings for production.

# ---- Supabase (Project Settings > API) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: there is no VITE_STRIPE_* variable — the Pro plan is a static
# Stripe Payment Link (see STRIPE_PAYMENT_LINK in src/lib/stripe.js),
# not a dynamically-created Checkout Session, so the client never needs
# any Stripe key at all, publishable or otherwise.

# ---------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. They are consumed by the
# Supabase Edge Functions in supabase/functions/, NOT by the Vite app —
# never prefix these with VITE_ or they would be bundled into the
# browser JS and leak publicly. Set them with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_xxx ...
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# SUPABASE_URL=https://your-project.supabase.co               (auto-set by Supabase)
# SUPABASE_ANON_KEY=...                                        (auto-set by Supabase)
# SUPABASE_SERVICE_ROLE_KEY=...                                 (Project Settings > API)
